# Copy this file to .env and fill in the values. Never share or commit .env itself.

# Database (Supabase -> Project Settings -> Database -> connection string)
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres

# Google sign-in (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Session tokens. Generate a long random value with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_EXPIRE_HOURS=8

# Addresses from these domains may sign in by themselves as Students.
ALLOWED_EMAIL_DOMAINS=vu.edu.pk
# These addresses become Admin the first time they sign in.
BOOTSTRAP_ADMIN_EMAILS=admin@example.com

# AI: Gemini is the primary classifier; Claude double-checks unsure answers (optional).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
AI_CONFIDENCE_THRESHOLD=0.70

# n8n: where the backend hands over emails, and the two secrets shared with n8n.
# Generate each secret the same way as JWT_SECRET.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/vu-query-events
N8N_WEBHOOK_SECRET=
SERVICE_KEY=

# Web
CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
SLA_HOURS=24